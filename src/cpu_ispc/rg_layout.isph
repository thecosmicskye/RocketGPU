      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_prev_world_wheel_contacts - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_game_jumped - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_game_double_jumped - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_cached_ground - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_jump_inactive_time - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_frame_open - (uniform int8 * uniform)p);
      out[k++] = (uniform int32)((uniform int8 * uniform)&p->cal_restored - (uniform int8 * uniform)p);
    }
}
