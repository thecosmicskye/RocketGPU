#pragma once
struct Vec3 {
    float x;
    float y;
    float z;
};
struct Quat {
    float w;
    float x;
    float y;
    float z;
};
struct BallHitInfo {
    uint8 is_valid;
    uint8 extra_pending;
    uint8 extra_tick_is_previous;
    uint8 reserved2;
    uint64 tick_count_when_hit;
    uint64 tick_count_when_extra_impulse_applied;
    uint32 hit_car_id;
    Vec3 relative_pos_on_ball;
    Vec3 ball_pos;
    Vec3 extra_hit_vel;
};
struct CarControls {
    float throttle;
    float steer;
    float pitch;
    float yaw;
    float roll;
    uint8 jump;
    uint8 boost;
    uint8 handbrake;
};
struct CarState_world_contact {
    uint8 has_contact;
    uint8 wheel_ball_mask;
